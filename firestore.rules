rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validChatMessage() {
      return request.resource.data.keys().hasAll(["text", "sender", "time"])
        && request.resource.data.keys().hasOnly(["text", "sender", "time"])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 900000
        && request.resource.data.sender in ["user", "ai"]
        && request.resource.data.time == request.time;
    }

    match /Users/{userId} {
      allow read, create, update: if ownsUserData(userId);

      match /Chats/{chatId} {
        allow get, list: if ownsUserData(userId);
        allow create: if ownsUserData(userId) && validChatMessage();
        allow update: if ownsUserData(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["chatTitle"])
          && request.resource.data.chatTitle is string
          && request.resource.data.chatTitle.size() <= 44;
      }
    }
  }
}
